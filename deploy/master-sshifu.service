# Системная служба запускает сервер от отдельной непривилегированной учетной записи.
[Unit]
Description=Сервер Master SSHifu
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sshifu
Group=sshifu
WorkingDirectory=/opt/master-sshifu
ExecStart=/opt/master-sshifu/vendor/sing-box run -c /etc/master-sshifu/server.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
